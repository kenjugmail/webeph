# Server-only. Set with `supabase secrets set`; never copy real values into Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_GENESIS_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_GENESIS_PRODUCT_ID=prod_YOUR_PRODUCT_ID
STRIPE_GENESIS_PRICE_ID=price_YOUR_PRICE_ID
STRIPE_GENESIS_PAYMENT_LINK_ID=plink_YOUR_PAYMENT_LINK_ID
STRIPE_GENESIS_LIVEMODE=false
GENESIS_EMAIL_HMAC_SECRET=GENERATE_A_RANDOM_SECRET
GENESIS_KEY_ENCRYPTION_KEY=BASE64URL_ENCODED_32_BYTE_KEY
GENESIS_SITE_ORIGIN=https://ephemerent.com

# Live direct-download fulfillment. Use a restricted Stripe key with only the
# Checkout Session read and Payment Link read/write permissions required here.
STRIPE_GENESIS_LIVE_RESTRICTED_KEY=rk_live_REPLACE_ME
STRIPE_GENESIS_LIVE_PRODUCT_ID=prod_REPLACE_ME
STRIPE_GENESIS_LIVE_PRICE_ID=price_REPLACE_ME
STRIPE_GENESIS_LIVE_PAYMENT_LINK_ID=plink_REPLACE_ME
STRIPE_GENESIS_LIVE_WEBHOOK_SECRET=whsec_REPLACE_ME
