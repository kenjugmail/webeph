{
  "name": "webeph",
  "private": true,
  "type": "module",
  "description": "Static site for ephemerent.com. No bundler: the .html files in this directory are the deployable artifact. `build` only runs integrity checks, so a broken link or a missing route fails the deploy instead of shipping.",
  "scripts": {
    "build": "node scripts/build-chrome.mjs --check && node scripts/check-links.mjs",
    "check": "node scripts/build-chrome.mjs --check && node scripts/check-links.mjs",
    "snapshot:before": "node scripts/snapshot-styles.mjs before",
    "snapshot:after": "node scripts/snapshot-styles.mjs after",
    "snapshot:diff": "node scripts/snapshot-styles.mjs diff",
    "chrome": "node scripts/build-chrome.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "responsive": "node scripts/check-responsive.mjs",
    "motion": "node scripts/check-motion.mjs",
    "verify": "npm run check && npm run contrast && npm run motion && npm run responsive && npm run layout && npm run alignment",
    "shoot": "node scripts/shoot.mjs",
    "plates": "python3 scripts/make-dark-plates.py",
    "layout": "node scripts/check-layout.mjs",
    "tracking": "node scripts/check-tracking.mjs",
    "jank": "node scripts/check-jank.mjs",
    "alignment": "node scripts/check-alignment.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
