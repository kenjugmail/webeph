{
  "redirects": [
    { "source": "/atlas", "destination": "https://atlas.ephemerent.com", "permanent": true },
    { "source": "/atlas/:path*", "destination": "https://atlas.ephemerent.com/:path*", "permanent": true },
    { "source": "/education", "destination": "https://atlas.ephemerent.com", "permanent": true },
    { "source": "/education/:path*", "destination": "https://atlas.ephemerent.com/:path*", "permanent": true },
    { "source": "/Ephemerent.html", "destination": "/", "permanent": true },
    { "source": "/research.html", "destination": "/research", "permanent": true },
    { "source": "/Orrery.html", "destination": "/orrery", "permanent": true },
    { "source": "/Vellum.html", "destination": "/vellum", "permanent": true },
    { "source": "/Vespera.html", "destination": "/vespera", "permanent": true },
    { "source": "/genesis-fall.html", "destination": "/genesis-fall", "permanent": true },
    { "source": "/genesis-fall-access.html", "destination": "/genesis-fall-access", "permanent": true },
    { "source": "/Shelterix.html", "destination": "/shelterix", "permanent": true },
    { "source": "/organizations.html", "destination": "/organizations", "permanent": true },
    { "source": "/security.html", "destination": "/security", "permanent": true },
    { "source": "/slack.html", "destination": "/slack", "permanent": true },
    { "source": "/download.html", "destination": "/download", "permanent": true },
    { "source": "/journal.html", "destination": "/journal", "permanent": true },
    { "source": "/journal-submit.html", "destination": "/journal/submit", "permanent": true },
    { "source": "/journal-policies.html", "destination": "/journal/policies", "permanent": true },
    { "source": "/news.html", "destination": "/news", "permanent": true },
    { "source": "/news-drfsp.html", "destination": "/news/drfsp-robust-compression", "permanent": true },
    { "source": "/arbiter-preview.html", "destination": "/arbiter", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/play", "destination": "https://web-five-amber-88.vercel.app/play" },
    { "source": "/play/:path*", "destination": "https://web-five-amber-88.vercel.app/play/:path*" },
    { "source": "/login", "destination": "https://web-five-amber-88.vercel.app/login" },
    { "source": "/login/:path*", "destination": "https://web-five-amber-88.vercel.app/login/:path*" },
    { "source": "/account", "destination": "https://web-five-amber-88.vercel.app/account" },
    { "source": "/account/:path*", "destination": "https://web-five-amber-88.vercel.app/account/:path*" },
    { "source": "/game", "destination": "https://web-five-amber-88.vercel.app/game" },
    { "source": "/game/:path*", "destination": "https://web-five-amber-88.vercel.app/game/:path*" },
    { "source": "/api/:path*", "destination": "https://web-five-amber-88.vercel.app/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://web-five-amber-88.vercel.app/_next/:path*" },
    { "source": "/status", "destination": "https://web-five-amber-88.vercel.app/status" },
    { "source": "/", "destination": "/Ephemerent.html" },
    { "source": "/research", "destination": "/research.html" },
    { "source": "/news", "destination": "/news.html" },
    { "source": "/news/drfsp-robust-compression", "destination": "/news-drfsp.html" },
    { "source": "/arbiter", "destination": "/arbiter-preview.html" },
    { "source": "/arbiter-preview", "destination": "/arbiter-preview.html" },
    { "source": "/orrery", "destination": "/Orrery.html" },
    { "source": "/vellum", "destination": "/Vellum.html" },
    { "source": "/vespera", "destination": "/Vespera.html" },
    { "source": "/genesis-fall", "destination": "/genesis-fall.html" },
    { "source": "/genesis-fall-access", "destination": "/genesis-fall-access.html" },
    { "source": "/shelterix", "destination": "/Shelterix.html" },
    { "source": "/organizations", "destination": "/organizations.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/slack", "destination": "/slack.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/journal", "destination": "/journal.html" },
    { "source": "/journal/submit", "destination": "/journal-submit.html" },
    { "source": "/journal/article/:slug", "destination": "/journal-article.html?slug=:slug" },
    { "source": "/journal/editor", "destination": "/journal-editor.html" },
    { "source": "/journal/policies", "destination": "/journal-policies.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "headers": [
    {
      "source": "/genesis-fall",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/genesis-fall-access",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
